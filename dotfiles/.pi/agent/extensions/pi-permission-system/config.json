{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-permission-system/main/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": false,
  "permission": {
    "*": "ask",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny"
    },
    "external_directory": "ask",
    "external_directory_read": {
      "*": "ask",
      "~/.pi/agent/*": "allow"
    },
    "bash": {
      "*": "ask",
      "ls": "allow",
      "ls *": "allow",
      "cd *": "allow",
      "pwd": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "tr *": "allow",
      "cut *": "allow",
      "echo *": "allow",
      "grep *": "allow",
      "file *": "allow",
      "diff *": "allow",
      "rg *": "allow",
      "date *": "allow",
      "du *": "allow",
      "man *": "allow",
      "cut *": "allow",
      "fold *": "allow",
      "free *": "allow",
      "readlink *": "allow",
      "which *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git grep *": "allow",
      "git ls-tree *": "allow",
      "git ls-files *": "allow",
      "git rev-parse *": "allow",
      "go version": "allow",
      "go test *": "allow",
      "go fmt *": "allow",
      "go vet *": "allow",
      "go doc *": "allow",
      "go build *": "allow"
    },
    "skill": {
      "*": "allow"
    },
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "write": "ask",
    "edit": "ask",
    "ask_user_question": "allow",
    "compress": "allow",
    "decompress": "allow",
    "acp_status": "allow",
    "acp_cache": "allow",
    "acp_delegate": "allow",
    "acp_delegate_wait": "allow",
    "search_context": "allow",
    "fetch_content": "allow"
  }
}
