{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-permission-system/main/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": false,
  "permission": {
    "*": "ask",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny"
    },
    "external_directory": "ask",
    "bash": {
      "*": "ask",
      "ls": "allow",
      "ls *": "allow",
      "cd *": "allow",
      "pwd": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "echo *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "which *": "allow",
      "sed -n *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "go version": "allow",
      "go test *": "allow",
      "go fmt *": "allow",
      "go vet *": "allow",
      "go doc *": "allow"
    },
    "skill": {
      "*": "allow"
    },
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "write": "ask",
    "edit": "ask",
    "ask_user_question": "allow",
    "compress": "allow",
    "decompress": "allow",
    "acp_status": "allow"
  }
}
