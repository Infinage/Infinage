{
  "defaultPolicy": {
    "tools": "ask",
    "bash": "ask",
    "mcp": "ask",
    "skills": "ask",
    "special": "ask"
  },
  "tools": {
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "write": "ask",
    "edit": "ask"
  },
  "bash": {
    "*": "ask",

    "ls": "allow",
    "ls *": "allow",
    "pwd": "allow",

    // Git read only commands
    "git status": "allow",
    "git diff": "allow",
    "git diff *": "allow",
    "git log": "allow",
    "git log *": "allow",

    // Go workflows
    "go test *": "allow",
    "go fmt *": "allow",
    "go vet *": "allow",
    "go version": "allow"
  }
}
