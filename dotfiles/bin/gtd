#!/usr/bin/env bash
set -e
set -u
set -o pipefail

NIX_PKGS="nixpkgs#go nixpkgs#tailwindcss nixpkgs#air nixpkgs#gnumake"

# Generate a random port between 8000 and 8999
PORT=$((8000 + RANDOM % 1000))

TEMP_DIR=$(mktemp -d)
cd "$TEMP_DIR" || exit 1

cleanup() {
    if [ -d "$TEMP_DIR" ]; then
        echo -e "\n🧹 Cleaning up $TEMP_DIR..."
        rm -rf "$TEMP_DIR"
    fi
}

# Ctrl+C kills the server, causes the script to end, triggering EXIT
trap cleanup EXIT

# Scaffold Makefile
cat << 'EOF' > Makefile
PORT ?= 8080
.PHONY: dev watch-css watch-go

dev:
	@echo "Spinning up Go + Tailwind + Datastar playground on port $(PORT)"
	@$(MAKE) -j2 watch-css watch-go

watch-css:
	tailwindcss -i input.css -o index.css --watch

watch-go:
	PORT=$(PORT) air
EOF

# Scaffold .air.toml
cat << 'EOF' > .air.toml
root = "."
tmp_dir = "tmp"

[build]
  cmd = "go build -o ./tmp/main ."
  bin = "./tmp/main"
  include_ext = ["go"]
  exclude_dir = ["tmp"]
  delay = 200

[log]
  time = false
EOF

# Scaffold index.html
cat << 'EOF' > index.html
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="index.css">
  <script src="datastar.js" type="module" defer></script>
</head>
<body>

</body>
</html>
EOF

# Scaffold minimal tailwind config
cat << 'EOF' > tailwind.config.js
module.exports = { content: ["./*.html"] }
EOF

# Scaffold input.css
cat << 'EOF' > input.css
@tailwind base;
@tailwind components;
@tailwind utilities;
EOF

# Scaffold main.go
cat << 'EOF' > main.go
package main

import (
	"log"
	"net/http"
	"os"
)

func main() {
	port := os.Getenv("PORT")
	if port == "" {
		port = "8080"
	}

	mux := http.NewServeMux()

	// API routes go under /api/
	mux.HandleFunc("/api/", func(w http.ResponseWriter, r *http.Request) {
		http.NotFound(w, r)
	})

	// Everything else is static files served from disk
	mux.Handle("/", http.FileServer(http.Dir(".")))

	println("🚀 Server running at http://localhost:" + port)
	if err := http.ListenAndServe(":"+port, mux); err != nil {
		log.Fatal(err)
	}
}
EOF

# Download datastar.js quietly (-s), but show errors if it fails (-S)
echo "Downloading Datastar..."
curl -fsSL https://cdn.jsdelivr.net/gh/starfederation/datastar@v1.0.3/bundles/datastar.js -o datastar.js

echo ""
echo "================================================="
echo "✨ Go + Tailwind + Datastar playground is LIVE!"
echo "📁 Edit files at: $TEMP_DIR"
echo "🌐 View page at:  http://localhost:$PORT"
echo "🛑 Press Ctrl+C here to stop the server and auto-delete the folder."
echo "================================================="
echo "Building Nix environment and starting server..."

nix shell $NIX_PKGS --command bash -c "
  go mod init playground > /dev/null 2>&1 || true
  make dev PORT=$PORT
"
