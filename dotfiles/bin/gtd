#!/usr/bin/env bash
set -euo pipefail

# -----------------------

step() { echo -e "\n > $1"; }
ok()   { echo "   [OK]   $1"; }
skip() { echo "   [SKIP] $1"; }
err()  { echo "   [FAIL] $1" >&2; }

# -----------------------

step "Checking dependencies..."

deps=("curl" "go" "tailwindcss" "air" "make")
missing=()
for dep in "${deps[@]}"; do
    if ! command -v "$dep" >/dev/null 2>&1; then
        missing+=("$dep")
    fi
done

if [ ${#missing[@]} -ne 0 ]; then
    err "Missing dependencies: ${missing[*]}"
    echo "          Please install them and try again." >&2
    echo ""
    exit 1
fi

ok "All required dependencies are installed."

# ------------------

step "Creating directories..."
mkdir -p assets/{html,js,css} tmp
ok "Created assets/html, assets/js, assets/css, and tmp/"

# -----------------------

step "Scaffolding configuration files..."

# Helper to write if file missing
scaffold_file() {
    local filepath="$1"
    if [ -f "$filepath" ]; then
        skip "$filepath (already exists)"
        return 0
    fi
    
    cat > "$filepath"
    ok "Created $filepath"
}

scaffold_file "Makefile" << 'EOF'
.PHONY: dev watch-css watch-go

dev:
	@$(MAKE) -j2 watch-css watch-go

watch-css:
	tailwindcss -i assets/css/input.css -o assets/css/index.css --watch

watch-go:
	air
EOF

scaffold_file ".air.toml" << 'EOF'
root = "."
tmp_dir = "tmp"

[build]
  cmd = "go build -o ./tmp/main ."
  bin = "./tmp/main"
  include_ext = ["go"]
  exclude_dir = ["tmp"]
  delay = 200

[log]
  time = false
EOF

scaffold_file "tailwind.config.js" << 'EOF'
module.exports = { content: ["./assets/html/*.html"] }
EOF

# -----------------------

step "Scaffolding frontend assets..."

scaffold_file "assets/html/index.html" << 'EOF'
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/assets/css/index.css">
  <script src="/assets/js/datastar.js" type="module" defer></script>
</head>
<body>

</body>
</html>
EOF

scaffold_file "assets/css/input.css" << 'EOF'
@import "tailwindcss";
EOF

DATASTAR_JS="assets/js/datastar.js"
step "Checking for datastar.js..."
if [ ! -f "$DATASTAR_JS" ]; then
    curl -fsSL https://cdn.jsdelivr.net/gh/starfederation/datastar/bundles/datastar.js -o "$DATASTAR_JS"
    ok "Downloaded datastar.js to assets/js/"
else
    skip "datastar.js (already exists)"
fi

# -----------------------

step "Initializing Go module (if needed)..."
if [ ! -f "go.mod" ]; then
    module_name=$(basename "$PWD" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9._-]/-/g; s/^[.-]*//')
    if [ -z "$module_name" ]; then
        err "Could not derive a module name from the current directory."
        echo "          Run 'go mod init <name>' manually and try again." >&2
        exit 1
    fi
    go mod init "$module_name"
    ok "Initialized go.mod with module name '$module_name'."
else
    skip "go.mod (already exists)"
fi

step "Installing datastar-go SDK..."
go get -u github.com/starfederation/datastar-go >/dev/null 2>&1
ok "Go SDK installed."

step "🚀 Good to Go!"
echo ""
